#: node_info_texts.cpp:65
msgid "Dreht das Bild im Raum um die Mitte, um die Achsen X, Y und Z (Winkel in Grad). Für 3D-Aufbauten."
msgstr "Обертає зображення в просторі навколо центру, навколо осей X, Y і Z (кути в градусах). Для 3D-конструкцій."

#: node_info_texts.cpp:63
msgid "Dreht das Bild um die Mitte (Winkel in Grad)."
msgstr "Обертає зображення навколо центру (кут у градусах)."

