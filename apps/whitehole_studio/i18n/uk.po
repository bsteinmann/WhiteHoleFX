msgstr "Проєкти WhiteHoleFX (*.whfx);;Усі файли (*)"

#: node_info_texts.cpp:73
msgid "Wie Strobe, blitzt aber nur, solange „Gate“ den Schwellwert erreicht, zum Beispiel der Puls einer Kick- oder Hi-Hat-Erkennung. Darunter geht das Bild unverändert durch."
msgstr "Як Strobe, але спалахує лише доки «Gate» досягає порогу, наприклад імпульс детектора бочки чи хай-хета. Нижче порогу зображення проходить без змін."

#: main_window_view3d.cpp:97
msgid "Wie in der 2D-Ansicht; graue Punkte der vorderen Schicht verdecken LEDs dahinter"
msgstr "Як у 2D-вигляді; сірі точки переднього шару затуляють LED позаду"

#: shape_form.cpp:169
msgid "Wie oft die Spirale um die Säule läuft (0 = gerade nach oben)"
msgstr "Скільки разів спіраль обвиває колону (0 = прямо вгору)"

#: node_info_texts.cpp:78
msgid "Wiederholt das Bild als Kacheln (Tiles X/Y/Z), auf Wunsch jede zweite gespiegelt."
msgstr "Повторює зображення плитками (Tiles X/Y/Z), за бажанням кожну другу віддзеркалено."

#: shape_form.cpp:177
msgid "Windungen"
msgstr "Витки"

#: shape_form.cpp:194
msgid "Winkel der ersten LED im untersten Ring: 0 = +x"
msgstr "Кут першого світлодіода в нижньому кільці: 0 = +x"

#: shape_form.cpp:148
msgid "Winkel der ersten LED: 0 = rechts, 90 = oben"
msgstr "Кут першого світлодіода: 0 = праворуч, 90 = вгору"

#: node_info_texts.cpp:84
msgid "Wirbel: Dreht das Bild um einen Mittelpunkt, in der Mitte am stärksten, nach außen abklingend (Radius)."
msgstr "Вихор: обертає зображення навколо центру, найсильніше в середині, назовні згасаючи (Radius)."

#: parameter_panel.cpp:293
msgid "Wird durch eine Verbindung im Graphen gesteuert."
msgstr "Керується зв'язком у графі."

#: parameter_panel.cpp:191
msgid "Wähle einen Node im Node-Editor, um seine Parameter zu sehen. Mit „Anheften“ bleibt ein Node hier stehen."
msgstr "Виберіть нод у редакторі нод, щоб побачити його параметри. «Закріпити» залишає нод тут."

