  point -3.928 21.745 -0.754
  point -3.683 21.906 -1.56
  point -3.275 22.067 -2.296
  point -2.722 22.228 -2.931
  point -2.048 22.389 -3.436
  point -1.284 22.55 -3.788
  point -0.463 22.711 -3.973
