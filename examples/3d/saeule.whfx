  point 1.204 23.034 -3.815
  point 1.976 23.195 -3.478
  point 2.66 23.356 -2.988
  point 3.226 23.517 -2.365
  point 3.65 23.678 -1.637
  point 3.911 23.839 -0.837
  point 4 24 -0
  patch artnet destination 0 universe 0 order GRB
end

node helix wh.generator.helix
  set radius 0.45
  set thickness 0.08
  set strands 2
  set pitch 2
  set speed 0.3
  set color 0 0.7 1 1
end
node welle wh.generator.wave
  set dirX 0
  set dirY 1
  set dirZ 0
  set frequency 1.5
  set speed 0.4
  set colorA 0 0 0 0
  set colorB 1 0.2 0.5 1
end
node mischen wh.blend.blend
  set mode 0
end
node farbton wh.modifier.coloradjust
end
node zeit wh.value.time
  set speed 0.05
end

connect welle.out -> mischen.a
connect helix.out -> mischen.b
connect mischen.out -> farbton.source
connect zeit.seconds -> farbton.hue
output farbton.out
